# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Real environment variables override anything set here.

# --- Groq ------------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Not every key can call every model. List yours with:
#   uv run python demo/server.py --list-models
GROQ_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.2

# --- Cache -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Cosine similarity required for a cache HIT (0.0 - 1.0).
SIMILARITY_THRESHOLD=0.90

# Seconds before a cached entry expires. Use `none` for no expiry.
TTL=3600

# Keeps this app's entries separate from other apps sharing the same Redis.
NAMESPACE=example

# --- Demo server -----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
